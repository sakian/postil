{
  "description": "postil: remind a listening session of submitted reviews, and keep it from stopping with review threads unanswered. Silent in every other session.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "P=\"${CLAUDE_PLUGIN_ROOT}/dist/postil.mjs\"; [ -f \"$P\" ] && node \"$P\" hook session-start || true",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "P=\"${CLAUDE_PLUGIN_ROOT}/dist/postil.mjs\"; [ -f \"$P\" ] && node \"$P\" hook prompt || true",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "P=\"${CLAUDE_PLUGIN_ROOT}/dist/postil.mjs\"; [ -f \"$P\" ] && node \"$P\" hook stop || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
